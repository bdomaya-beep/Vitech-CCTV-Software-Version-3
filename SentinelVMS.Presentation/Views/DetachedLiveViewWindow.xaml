<Window x:Class="SentinelVMS.Presentation.Views.DetachedLiveViewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SentinelVMS.Presentation.ViewModels"
        xmlns:views="clr-namespace:SentinelVMS.Presentation.Views"
        Title="Sentinel VMS - Detached Live View"
        Height="860" Width="1500"
        MinHeight="620" MinWidth="1000"
        Background="{StaticResource AppBackgroundBrush}"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="26"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="&#9673;" FontSize="18" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="DETACHED LIVE VIEW" FontSize="13" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <Rectangle Grid.Column="1" Width="1" Fill="{StaticResource BorderBrush}" Margin="0,10"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                    <TextBlock Text="LAYOUT" FontSize="9" FontWeight="SemiBold"
                               Foreground="{StaticResource TextMutedBrush}"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Button Width="34" Height="28" Content="1x1"
                            Command="{Binding SetGridLayoutCommand}" CommandParameter="1"
                            Style="{StaticResource GridButtonStyle}" Margin="2,0"/>
                    <Button Width="34" Height="28" Content="2x2"
                            Command="{Binding SetGridLayoutCommand}" CommandParameter="4"
                            Style="{StaticResource GridButtonStyle}" Margin="2,0"/>
                    <Button Width="34" Height="28" Content="3x3"
                            Command="{Binding SetGridLayoutCommand}" CommandParameter="9"
                            Style="{StaticResource GridButtonStyle}" Margin="2,0"/>
                    <Button Width="34" Height="28" Content="4x4"
                            Command="{Binding SetGridLayoutCommand}" CommandParameter="16"
                            Style="{StaticResource GridButtonStyle}" Margin="2,0"/>
                    <Button Width="34" Height="28" Content="5x5"
                            Command="{Binding SetGridLayoutCommand}" CommandParameter="25"
                            Style="{StaticResource GridButtonStyle}" Margin="2,0"/>
                    <Button Width="34" Height="28" Content="6x6"
                            Command="{Binding SetGridLayoutCommand}" CommandParameter="36"
                            Style="{StaticResource GridButtonStyle}" Margin="2,0"/>
                    <Button Width="34" Height="28" Content="8x8"
                            Command="{Binding SetGridLayoutCommand}" CommandParameter="64"
                            Style="{StaticResource GridButtonStyle}" Margin="2,0"/>
                </StackPanel>

                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Width="86" Height="30" Content="Refresh"
                            Command="{Binding RefreshCommand}"
                            Style="{StaticResource FlatButtonStyle}"
                            FontSize="11" Margin="4,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" MinWidth="180" MaxWidth="400"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource AppBackgroundBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,9">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="CAMERAS" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="10"
                                       Foreground="{StaticResource AccentBrush}" Margin="0,0,2,0">
                                <Run Text="{Binding ConnectedDeviceCount}"/><Run Text=" online"/>
                            </TextBlock>
                        </DockPanel>
                    </Border>

                    <TreeView Grid.Row="1"
                              ItemsSource="{Binding DeviceTree}"
                              Background="Transparent" BorderThickness="0"
                              Padding="4,6"
                              Foreground="{StaticResource TextPrimaryBrush}"
                              ItemContainerStyle="{StaticResource TreeViewItemStyle}">
                        <TreeView.Resources>
                            <HierarchicalDataTemplate DataType="{x:Type vm:DeviceTreeItemViewModel}"
                                                      ItemsSource="{Binding Children}">
                                <Grid PreviewMouseMove="TreeItem_PreviewMouseMove" Margin="0,1" MinHeight="22">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Ellipse Grid.Column="0" Width="7" Height="7"
                                             VerticalAlignment="Center" Margin="0,0,4,0"
                                             Fill="{Binding StatusDotBrush}"/>

                                    <TextBlock Grid.Column="1" Text="{Binding Name}"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               FontSize="12" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>

                                    <Border Grid.Column="2"
                                            Background="{StaticResource SelectionBrush}"
                                            CornerRadius="8" Padding="5,2" Margin="4,0,0,0"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding IsDevice, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="{Binding ChannelCountLabel}" FontSize="9"
                                                   FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                                    </Border>
                                </Grid>
                            </HierarchicalDataTemplate>
                        </TreeView.Resources>
                    </TreeView>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                          Background="{StaticResource BorderBrush}" Cursor="SizeWE"/>

            <Border Grid.Column="2" Background="{StaticResource AppBackgroundBrush}">
                <views:LiveViewControl DataContext="{Binding LiveViewModel}"/>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource SidebarBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="11"
                           Text="Detached live view ready"
                           Foreground="{StaticResource TextSecondaryBrush}"/>

                <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="11"
                           Text="{Binding MetricsText}"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,12,0"/>
            </Grid>
        </Border>
    </Grid>
</Window>
