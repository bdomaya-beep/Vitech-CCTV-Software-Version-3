<UserControl x:Class="SentinelVMS.Presentation.Views.PlaybackControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:rendering="clr-namespace:SentinelVMS.Rendering.Wpf;assembly=SentinelVMS.Rendering">
    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- Search bar -->
            <RowDefinition Height="*"/>      <!-- Video area -->
            <RowDefinition Height="Auto"/>   <!-- Timeline + controls -->
        </Grid.RowDefinitions>

        <!-- ═══ Search bar ═══ -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="14,8">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">

                <!-- Channel selector -->
                <Border Background="{StaticResource SurfaceElevatedBrush}"
                        CornerRadius="4" Padding="8,0,0,0" Height="32" Margin="0,4,12,4"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Channel" VerticalAlignment="Center"
                                   FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,8,0"/>
                        <ComboBox Width="250" Height="32"
                                  ItemsSource="{Binding Channels}"
                                  SelectedItem="{Binding SelectedChannel}"
                                  DisplayMemberPath="DisplayName"
                                  Style="{StaticResource InputComboBoxStyle}"/>
                    </StackPanel>
                </Border>

                <!-- Date + time row -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,12,4">
                    <TextBlock Text="Date" VerticalAlignment="Center"
                               FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,6,0"/>
                    <DatePicker Width="160" Height="32" Margin="0,0,12,0"
                                SelectedDate="{Binding SelectedDate}"
                                SelectedDateFormat="Short"
                                Style="{StaticResource InputDatePickerStyle}"/>

                    <TextBlock Text="Start" VerticalAlignment="Center"
                               FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,6,0"/>
                    <TextBox Width="86" Height="32" Margin="0,0,12,0"
                             Text="{Binding StartTimeText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Start time — HH:mm:ss"
                             Style="{StaticResource InputTextBoxStyle}"/>

                    <TextBlock Text="End" VerticalAlignment="Center"
                               FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,6,0"/>
                    <TextBox Width="86" Height="32" Margin="0,0,12,0"
                             Text="{Binding EndTimeText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="End time — HH:mm:ss"
                             Style="{StaticResource InputTextBoxStyle}"/>
                </StackPanel>

                <!-- Search / Stop buttons -->
                <Button Width="96" Height="32" Margin="0,4,6,4"
                        Content="🔍  Search"
                        Command="{Binding StartPlaybackCommand}"
                        Style="{StaticResource AccentButtonStyle}"/>

                <Button Width="72" Height="32" Margin="0,4,12,4"
                        Content="■  Stop"
                        Command="{Binding StopPlaybackCommand}"
                        Style="{StaticResource FlatButtonStyle}"/>

                <!-- Status / error -->
                <StackPanel VerticalAlignment="Center" Margin="0,4,0,4">
                    <TextBlock Text="{Binding StatusText}" FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding ErrorText}" FontSize="11"
                               Foreground="{StaticResource OfflineBrush}"/>
                </StackPanel>
            </WrapPanel>
        </Border>

        <!-- ═══ Video area ═══ -->
        <Border Grid.Row="1"
                Background="#FF050A0F"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0"
                Margin="0">
            <Grid>
                <rendering:D3DImageHost ChannelId="{Binding RenderChannelId}"/>

                <!-- Current-time overlay (bottom-left) -->
                <Border VerticalAlignment="Bottom" HorizontalAlignment="Left"
                        Margin="12,0,0,12"
                        Background="#99000000" CornerRadius="4" Padding="10,4">
                    <TextBlock Text="{Binding CurrentPositionText}"
                               Foreground="White" FontSize="13" FontFamily="Consolas"
                               FontWeight="SemiBold"/>
                </Border>

                <!-- No-channel placeholder -->
                <TextBlock Text="Select a channel and press Search to begin playback"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="14" Foreground="{StaticResource TextMutedBrush}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPlaying}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>

        <!-- ═══ Timeline + controls panel ═══ -->
        <Border Grid.Row="2"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="14,10,14,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>   <!-- Range labels -->
                    <RowDefinition Height="Auto"/>   <!-- Timeline slider -->
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>   <!-- Transport controls -->
                </Grid.RowDefinitions>

                <!-- Range end-point labels -->
                <DockPanel Grid.Row="0" Margin="0,0,0,3">
                    <TextBlock DockPanel.Dock="Left"
                               Text="{Binding RangeStartLabel}"
                               FontSize="10" Foreground="{StaticResource TextMutedBrush}"
                               FontFamily="Consolas"/>
                    <TextBlock DockPanel.Dock="Right"
                               Text="{Binding RangeEndLabel}"
                               FontSize="10" Foreground="{StaticResource TextMutedBrush}"
                               FontFamily="Consolas" HorizontalAlignment="Right"/>
                    <TextBlock HorizontalAlignment="Center"
                               Text="{Binding CurrentPositionText}"
                               FontSize="11" Foreground="{StaticResource AccentBrush}"
                               FontFamily="Consolas" FontWeight="SemiBold"/>
                </DockPanel>

                <!-- Seek slider -->
                <Slider Grid.Row="1"
                        Minimum="0" Maximum="100"
                        Value="{Binding PlaybackPosition, Mode=TwoWay}"
                        IsEnabled="{Binding IsPlaying}"
                        Height="18"
                        IsMoveToPointEnabled="True">
                    <Slider.Resources>
                        <Style TargetType="Slider">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Slider">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto" MinHeight="{TemplateBinding MinHeight}"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Track x:Name="PART_Track" Grid.Row="1">
                                                <Track.DecreaseRepeatButton>
                                                    <RepeatButton Command="Slider.DecreaseLarge">
                                                        <RepeatButton.Template>
                                                            <ControlTemplate TargetType="RepeatButton">
                                                                <Border Height="4" Background="{StaticResource AccentBrush}" CornerRadius="2,0,0,2"/>
                                                            </ControlTemplate>
                                                        </RepeatButton.Template>
                                                    </RepeatButton>
                                                </Track.DecreaseRepeatButton>
                                                <Track.IncreaseRepeatButton>
                                                    <RepeatButton Command="Slider.IncreaseLarge">
                                                        <RepeatButton.Template>
                                                            <ControlTemplate TargetType="RepeatButton">
                                                                <Border Height="4" Background="{StaticResource BorderBrush}" CornerRadius="0,2,2,0"/>
                                                            </ControlTemplate>
                                                        </RepeatButton.Template>
                                                    </RepeatButton>
                                                </Track.IncreaseRepeatButton>
                                                <Track.Thumb>
                                                    <Thumb>
                                                        <Thumb.Template>
                                                            <ControlTemplate TargetType="Thumb">
                                                                <Ellipse Width="14" Height="14"
                                                                         Fill="{StaticResource AccentBrush}"
                                                                         Stroke="White" StrokeThickness="2"/>
                                                            </ControlTemplate>
                                                        </Thumb.Template>
                                                    </Thumb>
                                                </Track.Thumb>
                                            </Track>
                                        </Grid>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Slider.Resources>
                </Slider>

                <!-- Transport controls -->
                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center">

                    <!-- Slow down -->
                    <Button Width="36" Height="32" Margin="3,0"
                            Content="◀◀" FontSize="11"
                            ToolTip="Slow down"
                            Command="{Binding SlowDownCommand}"
                            Style="{StaticResource FlatButtonStyle}"/>

                    <!-- Play / Pause -->
                    <Button Width="80" Height="32" Margin="3,0"
                            Content="{Binding PlayPauseContent}"
                            FontSize="13"
                            Command="{Binding PlayPauseCommand}"
                            Style="{StaticResource AccentButtonStyle}"/>

                    <!-- Stop -->
                    <Button Width="36" Height="32" Margin="3,0"
                            Content="■" FontSize="12"
                            ToolTip="Stop"
                            Command="{Binding StopPlaybackCommand}"
                            Style="{StaticResource FlatButtonStyle}"/>

                    <!-- Speed up -->
                    <Button Width="36" Height="32" Margin="3,0"
                            Content="▶▶" FontSize="11"
                            ToolTip="Speed up"
                            Command="{Binding SpeedUpCommand}"
                            Style="{StaticResource FlatButtonStyle}"/>

                    <!-- Speed label -->
                    <Border Margin="12,0,0,0" VerticalAlignment="Center"
                            Background="{StaticResource SurfaceElevatedBrush}"
                            CornerRadius="4" Padding="10,4">
                        <TextBlock Text="{Binding SpeedText}"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentBrush}"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
