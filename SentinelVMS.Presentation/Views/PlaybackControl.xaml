<UserControl x:Class="SentinelVMS.Presentation.Views.PlaybackControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:rendering="clr-namespace:SentinelVMS.Rendering.Wpf;assembly=SentinelVMS.Rendering">
    <Grid Background="{StaticResource AppBackgroundBrush}" Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <ComboBox Grid.Column="0"
                          Height="34"
                          Margin="0,0,8,0"
                          ItemsSource="{Binding Channels}"
                          SelectedItem="{Binding SelectedChannel}"
                          DisplayMemberPath="DisplayName"/>

                <TextBox Grid.Column="1"
                         Height="34"
                         Margin="0,0,8,0"
                         Text="{Binding StartLocalText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Start local time: yyyy-MM-dd HH:mm:ss"
                         Style="{StaticResource InputTextBoxStyle}"/>

                <TextBox Grid.Column="2"
                         Height="34"
                         Margin="0,0,8,0"
                         Text="{Binding EndLocalText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="End local time: yyyy-MM-dd HH:mm:ss"
                         Style="{StaticResource InputTextBoxStyle}"/>

                <Button Grid.Column="3"
                        Width="90"
                        Height="34"
                        Margin="0,0,8,0"
                        Content="Play"
                        Command="{Binding StartPlaybackCommand}"
                        Style="{StaticResource AccentButtonStyle}"/>

                <Button Grid.Column="4"
                        Width="90"
                        Height="34"
                        Margin="0,0,8,0"
                        Content="Stop"
                        Command="{Binding StopPlaybackCommand}"
                        Style="{StaticResource FlatButtonStyle}"/>

                <StackPanel Grid.Column="5" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding ErrorText}" FontSize="11" Foreground="{StaticResource OfflineBrush}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="3">
            <rendering:D3DImageHost ChannelId="{Binding RenderChannelId}"/>
        </Border>
    </Grid>
</UserControl>
