<Window x:Class="SentinelVMS.Presentation.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SentinelVMS.Presentation.ViewModels"
        xmlns:views="clr-namespace:SentinelVMS.Presentation.Views"
        Title="Sentinel VMS"
        Height="900" Width="1600"
        MinHeight="600" MinWidth="1000"
        Background="{StaticResource AppBackgroundBrush}"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <DataTemplate DataType="{x:Type vm:LiveViewViewModel}">
            <views:LiveViewControl/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DeviceManagementViewModel}">
            <views:DeviceManagementControl/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PlaybackViewModel}">
            <views:PlaybackControl/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="26"/>
        </Grid.RowDefinitions>

        <!-- TOP BAR -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="&#9673;" FontSize="18" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="SENTINEL VMS" FontSize="13" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <Rectangle Grid.Column="1" Width="1" Fill="{StaticResource BorderBrush}" Margin="0,10"/>

                <!-- Nav tabs -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Stretch" Margin="8,0">
                    <Button Height="50" Width="76" Content="Live"
                            Command="{Binding OpenLiveViewCommand}"
                            Style="{StaticResource FlatButtonStyle}"
                            FontSize="12" FontWeight="SemiBold"
                            Foreground="{StaticResource AccentBrush}"/>
                    <Button Height="50" Width="82" Content="Devices"
                            Command="{Binding OpenDevicesCommand}"
                            Style="{StaticResource FlatButtonStyle}"
                            FontSize="12"/>
                        <Button Height="50" Width="86" Content="Playback"
                            Command="{Binding OpenPlaybackCommand}"
                            Style="{StaticResource FlatButtonStyle}"
                            FontSize="12"/>
                </StackPanel>

                <Rectangle Grid.Column="3" Width="1" Fill="{StaticResource BorderBrush}" Margin="0,10"/>

                <!-- Layout buttons -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                    <TextBlock Text="LAYOUT" FontSize="9" FontWeight="SemiBold"
                               Foreground="{StaticResource TextMutedBrush}"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Button Width="34" Height="28" Content="1x1"
                            Command="{Binding SetGridLayoutCommand}" CommandParameter="1"
                            Style="{StaticResource GridButtonStyle}" Margin="2,0"/>
                    <Button Width="34" Height="28" Content="2x2"
                            Command="{Binding SetGridLayoutCommand}" CommandParameter="4"
                            Style="{StaticResource GridButtonStyle}" Margin="2,0"/>
                    <Button Width="34" Height="28" Content="3x3"
                            Command="{Binding SetGridLayoutCommand}" CommandParameter="9"
                            Style="{StaticResource GridButtonStyle}" Margin="2,0"/>
                    <Button Width="34" Height="28" Content="4x4"
                            Command="{Binding SetGridLayoutCommand}" CommandParameter="16"
                            Style="{StaticResource GridButtonStyle}" Margin="2,0"/>
                    <Button Width="34" Height="28" Content="5x5"
                            Command="{Binding SetGridLayoutCommand}" CommandParameter="25"
                            Style="{StaticResource GridButtonStyle}" Margin="2,0"/>
                    <Button Width="34" Height="28" Content="6x6"
                            Command="{Binding SetGridLayoutCommand}" CommandParameter="36"
                            Style="{StaticResource GridButtonStyle}" Margin="2,0"/>
                    <Button Width="34" Height="28" Content="8x8"
                            Command="{Binding SetGridLayoutCommand}" CommandParameter="64"
                            Style="{StaticResource GridButtonStyle}" Margin="2,0"/>
                </StackPanel>

                <!-- Action buttons -->
                <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                    <Button Width="110" Height="30" Content="+ Add Device"
                            Command="{Binding AddDeviceCommand}"
                            Style="{StaticResource AccentButtonStyle}"
                            FontSize="11" Margin="4,0"/>
                    <Button Width="100" Height="30" Content="Discover"
                            Command="{Binding DiscoverDevicesCommand}"
                            Style="{StaticResource FlatButtonStyle}"
                            FontSize="11" Margin="4,0"/>
                    <Button Width="76" Height="30" Content="Pop Out"
                            Command="{Binding OpenLivePopoutCommand}"
                            Style="{StaticResource FlatButtonStyle}"
                            FontSize="11" Margin="4,0"/>
                </StackPanel>

                <!-- User + Logout -->
                <StackPanel Grid.Column="7" Orientation="Horizontal" VerticalAlignment="Center">
                    <Rectangle Width="1" Fill="{StaticResource BorderBrush}" Margin="0,10"/>
                    <TextBlock Margin="14,0,6,0" VerticalAlignment="Center" FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}">
                        <Run Text="{Binding CurrentUser}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                    </TextBlock>
                    <Button Width="72" Height="30" Content="Sign Out"
                            Command="{Binding LogoutCommand}"
                            Style="{StaticResource DangerButtonStyle}"
                            FontSize="11" Margin="8,0,4,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN BODY -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" MinWidth="180" MaxWidth="400"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Device/Camera Panel -->
            <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Panel header -->
                    <Border Grid.Row="0" Background="{StaticResource AppBackgroundBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,9">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="CAMERAS" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="10"
                                       Foreground="{StaticResource AccentBrush}" Margin="0,0,2,0">
                                <Run Text="{Binding ConnectedDeviceCount}"/><Run Text=" online"/>
                            </TextBlock>
                        </DockPanel>
                    </Border>

                    <!-- Device TreeView -->
                    <TreeView Grid.Row="1" x:Name="DeviceTreeView"
                              ItemsSource="{Binding DeviceTree}"
                              Background="Transparent" BorderThickness="0"
                              Padding="4,6"
                              Foreground="{StaticResource TextPrimaryBrush}"
                              ItemContainerStyle="{StaticResource TreeViewItemStyle}">
                        <TreeView.Resources>
                            <HierarchicalDataTemplate DataType="{x:Type vm:DeviceTreeItemViewModel}"
                                                      ItemsSource="{Binding Children}">
                                <Grid PreviewMouseMove="TreeItem_PreviewMouseMove" Margin="0,1" MinHeight="22">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Colored status dot -->
                                    <Ellipse Grid.Column="0" Width="7" Height="7"
                                             VerticalAlignment="Center" Margin="0,0,4,0"
                                             Fill="{Binding StatusDotBrush}"/>

                                    <!-- Channel / Device name -->
                                    <TextBlock Grid.Column="1" Text="{Binding Name}"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               FontSize="12" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>

                                    <!-- Channel count badge on NVR nodes -->
                                    <Border Grid.Column="2"
                                            Background="{StaticResource SelectionBrush}"
                                            CornerRadius="8" Padding="5,2" Margin="4,0,0,0"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding IsDevice, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="{Binding ChannelCountLabel}" FontSize="9"
                                                   FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                                    </Border>
                                </Grid>
                            </HierarchicalDataTemplate>
                        </TreeView.Resources>
                    </TreeView>
                </Grid>
            </Border>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                          Background="{StaticResource BorderBrush}" Cursor="SizeWE"/>

            <!-- Right: main workspace -->
            <Border Grid.Column="2" Background="{StaticResource AppBackgroundBrush}">
                <ContentControl Content="{Binding CurrentWorkspace}"/>
            </Border>
        </Grid>

        <!-- STATUS BAR -->
        <Border Grid.Row="2" Background="{StaticResource SidebarBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="11"
                           Text="{Binding StatusText}"
                           Foreground="{StaticResource TextSecondaryBrush}"/>

                <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="11"
                           Text="{Binding MetricsText}"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,12,0"/>

                <Rectangle Grid.Column="2" Fill="{StaticResource BorderBrush}" Margin="0,4"/>

                <TextBlock Grid.Column="3" Margin="12,0" VerticalAlignment="Center" FontSize="11">
                    <Run Text="&#9679; " Foreground="{StaticResource OnlineBrush}"/>
                    <Run Text="{Binding ConnectedDeviceCount}"
                         Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                    <Run Text=" devices online" Foreground="{StaticResource TextSecondaryBrush}"/>
                </TextBlock>

                <Rectangle Grid.Column="4" Fill="{StaticResource BorderBrush}" Margin="0,4"/>

                <TextBlock Grid.Column="5" Margin="12,0,4,0" VerticalAlignment="Center" FontSize="11"
                           Foreground="{StaticResource TextSecondaryBrush}">
                    <Run Text="{Binding CurrentUser}" Foreground="{StaticResource AccentBrush}"/>
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</Window>
