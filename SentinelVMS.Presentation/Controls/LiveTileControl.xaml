<UserControl x:Class="SentinelVMS.Presentation.Controls.LiveTileControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:rendering="clr-namespace:SentinelVMS.Rendering.Wpf;assembly=SentinelVMS.Rendering">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Border CornerRadius="6" BorderThickness="1" ClipToBounds="True"
            AllowDrop="True"
            Drop="TileBorder_OnDrop"
            DragOver="TileBorder_OnDragOver"
            MouseLeftButtonDown="TileBorder_OnMouseLeftButtonDown">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background"   Value="#FF0F1720"/>
                <Setter Property="BorderBrush"  Value="#FF1C2B3A"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                        <Setter Property="BorderBrush" Value="#FF22C55E"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsPlaceholder}" Value="True">
                        <Setter Property="BorderBrush" Value="#FF1C2B3A"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid>
            <!-- Video surface -->
            <Border x:Name="VideoViewport"
                    Background="Transparent"
                    ClipToBounds="True"
                    PreviewMouseWheel="VideoViewport_OnPreviewMouseWheel"
                    MouseRightButtonDown="VideoViewport_OnMouseRightButtonDown"
                    MouseRightButtonUp="VideoViewport_OnMouseRightButtonUp"
                    MouseMove="VideoViewport_OnMouseMove">
                <rendering:D3DImageHost x:Name="VideoSurface" ChannelId="{Binding RenderChannelId}" RenderTransformOrigin="0.5,0.5">
                    <rendering:D3DImageHost.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="VideoScaleTransform" ScaleX="1" ScaleY="1"/>
                            <TranslateTransform x:Name="VideoTranslateTransform" X="0" Y="0"/>
                        </TransformGroup>
                    </rendering:D3DImageHost.RenderTransform>
                </rendering:D3DImageHost>
            </Border>

            <!-- ── PLACEHOLDER STATE ── -->
            <Grid Visibility="{Binding IsPlaceholder, Converter={StaticResource BoolToVis}}">
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FF0A1018" Offset="0"/>
                        <GradientStop Color="#FF0F1A28" Offset="1"/>
                    </LinearGradientBrush>
                </Grid.Background>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="&#128247;" FontSize="32" HorizontalAlignment="Center"
                               Opacity="0.25" Margin="0,0,0,12"/>
                    <TextBlock Text="Drop Channel Here" HorizontalAlignment="Center"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="#FF3A5570" Margin="0,0,0,4"/>
                    <TextBlock Text="Drag from camera panel" HorizontalAlignment="Center"
                               FontSize="10" Foreground="#FF243545"/>
                </StackPanel>
                <!-- Slot label bottom-left -->
                <TextBlock Text="{Binding Title}" Margin="8" VerticalAlignment="Bottom"
                           FontSize="10" Foreground="#FF1E3040"/>
            </Grid>

            <!-- ── ACTIVE TILE OVERLAYS ── -->
            <!-- Top header bar -->
            <Border Height="32" VerticalAlignment="Top">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPlaceholder}" Value="False">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#CC060C12" Offset="0"/>
                        <GradientStop Color="#00060C12" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <DockPanel Margin="10,0">
                    <!-- Connection indicator dot + title -->
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="#FFEF4444"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                            <Setter Property="Fill" Value="#FF22C55E"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="SemiBold"
                                   Foreground="White" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" MaxWidth="160"/>
                    </StackPanel>
                    <!-- Metrics -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Fps, StringFormat={}{0:F0} fps}"
                                   FontSize="10" Foreground="#AAE2EAF4" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding BitrateKbps, StringFormat={}{0} kbps}"
                                   FontSize="10" Foreground="#AAE2EAF4"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Error overlay -->
            <Border VerticalAlignment="Center" HorizontalAlignment="Center"
                    Background="#CC080E14" Padding="12,8" CornerRadius="6"
                    Visibility="{Binding IsErrorVisible, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="&#9888;" FontSize="20" HorizontalAlignment="Center"
                               Foreground="#FFEF4444" Margin="0,0,0,6"/>
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#FFFC8181"
                               TextWrapping="Wrap" TextAlignment="Center" MaxWidth="220" FontSize="11"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
