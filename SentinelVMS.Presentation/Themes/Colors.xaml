<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══ Background Layers ═══ -->
    <Color x:Key="AppBackgroundColor">#FF090E14</Color>
    <Color x:Key="SurfaceColor">#FF0F1720</Color>
    <Color x:Key="SurfaceElevatedColor">#FF162030</Color>
    <Color x:Key="SidebarColor">#FF0B1219</Color>
    <Color x:Key="InputBgColor">#FF0C1520</Color>
    <Color x:Key="BorderColor">#FF1C2B3A</Color>
    <Color x:Key="BorderSubtleColor">#FF162030</Color>
    <Color x:Key="HoverColor">#FF1A2840</Color>
    <Color x:Key="SelectionColor">#FF1E3555</Color>

    <!-- ═══ Accent ═══ -->
    <Color x:Key="AccentColor">#FF1A8CFF</Color>
    <Color x:Key="AccentHoverColor">#FF3DA0FF</Color>
    <Color x:Key="AccentPressedColor">#FF0F72E0</Color>

    <!-- ═══ Text ═══ -->
    <Color x:Key="TextPrimaryColor">#FFE2EAF4</Color>
    <Color x:Key="TextSecondaryColor">#FF7B96B2</Color>
    <Color x:Key="TextMutedColor">#FF445A6E</Color>
    <Color x:Key="TextOnAccentColor">#FFFFFFFF</Color>

    <!-- ═══ Status ═══ -->
    <Color x:Key="OnlineColor">#FF22C55E</Color>
    <Color x:Key="OfflineColor">#FFEF4444</Color>
    <Color x:Key="DegradedColor">#FFF59E0B</Color>
    <Color x:Key="UnknownColor">#FF4B5563</Color>
    <Color x:Key="DangerColor">#FFE53E3E</Color>
    <Color x:Key="DangerHoverColor">#FFFC5050</Color>

    <!-- ═══ Brushes ═══ -->
    <SolidColorBrush x:Key="AppBackgroundBrush"    Color="{StaticResource AppBackgroundColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush"          Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="SurfaceElevatedBrush"  Color="{StaticResource SurfaceElevatedColor}"/>
    <SolidColorBrush x:Key="SidebarBrush"          Color="{StaticResource SidebarColor}"/>
    <SolidColorBrush x:Key="InputBgBrush"          Color="{StaticResource InputBgColor}"/>
    <SolidColorBrush x:Key="BorderBrush"           Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="BorderSubtleBrush"     Color="{StaticResource BorderSubtleColor}"/>
    <SolidColorBrush x:Key="HoverBrush"            Color="{StaticResource HoverColor}"/>
    <SolidColorBrush x:Key="SelectionBrush"        Color="{StaticResource SelectionColor}"/>
    <SolidColorBrush x:Key="AccentBrush"           Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentHoverBrush"      Color="{StaticResource AccentHoverColor}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush"      Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush"    Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextMutedBrush"        Color="{StaticResource TextMutedColor}"/>
    <SolidColorBrush x:Key="OnlineBrush"           Color="{StaticResource OnlineColor}"/>
    <SolidColorBrush x:Key="OfflineBrush"          Color="{StaticResource OfflineColor}"/>
    <SolidColorBrush x:Key="DegradedBrush"         Color="{StaticResource DegradedColor}"/>
    <SolidColorBrush x:Key="UnknownBrush"          Color="{StaticResource UnknownColor}"/>
    <SolidColorBrush x:Key="DangerBrush"           Color="{StaticResource DangerColor}"/>
</ResourceDictionary>
